# =========================================================
# CLERK AUTHENTICATION
# =========================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
CLERK_ENVIRONMENT="development"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"

NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=""


# =========================================================
# CLOUDFLARE R2
# =========================================================

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_FILE_BASE_PATH=""


# =========================================================
# CLOUDINARY
# Server-side only.
# Do NOT prefix API credentials/secrets with NEXT_PUBLIC_.
# =========================================================

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# =========================================================
# EMAIL
# =========================================================

EMAIL_USER=""
EMAIL_PASS=""


# =========================================================
# WHATSAPP / EVOLUTION API
# Example:
# EVOLUTION_API_URL="https://evolution.example.com"
# =========================================================

EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# =========================================================
# Certificado digital usado exclusivamente para assinatura de receitas.
# O arquivo PFX NÃO deve ficar dentro do repositório.
# =========================================================
PRESCRIPTION_SIGNING_PFX_PATH=
PRESCRIPTION_SIGNING_PFX_PASSWORD=

# SHA-256 do certificado que é permitido assinar receitas.
# Pode ser informado com ou sem ":".
PRESCRIPTION_SIGNING_CERTIFICATE_SHA256=

# MERCADO PAGO — habilitação controlada; nunca versionar credenciais reais.
MERCADO_PAGO_ENABLED=false
# Ativar somente após preflight e smoke tests PROD. Não altera a conciliação.
MERCADO_PAGO_PRODUCTION_RELEASE_READY=false
MERCADO_PAGO_TEST_MODE=true
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
NEXT_PUBLIC_ENABLE_DEBIT_CARD=false
# Opcional: nome comercial reconhecível, 1 a 10 caracteres alfanuméricos/espaços.
# Se vazio, usa configuração da conta do provedor; não inventar nome.
MERCADO_PAGO_STATEMENT_DESCRIPTOR=
